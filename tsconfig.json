{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": ["./src/*"],
      "@app/*": ["./app/*"]
    }
  },
  "include": [
    "index.ts",
    "App.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
