{
  "name": "ledger",
  "version": "0.2.0",
  "description": "India-first, on-device expense tracker. React Native app on a platform-agnostic parser core.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.core.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.11",
    "expo-auth-session": "~6.0.1",
    "expo-crypto": "~14.0.1",
    "expo-dev-client": "~5.0.4",
    "expo-file-system": "~18.0.4",
    "expo-linear-gradient": "~14.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.1",
    "llama.rn": "^0.4.7",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "private": true
}
